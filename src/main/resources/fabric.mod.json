{
  "schemaVersion": 1,
  "id": "simplecoords",
  "version": "${version}",
  "name": "SimpleCoords",
  "description": "A coordinate HUD with facing direction, biome and configurable positioning.",
  "authors": [
    "Fayber"
  ],
  "contact": {
    "homepage": "https://github.com/Fayberr/SimpleCoords-Minecraft-Mod"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/simplecoords/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.fayber.simplecoords.SimpleCoords"
    ],
    "modmenu": [
      "com.fayber.simplecoords.SimpleCoordsModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modernconfig": ">=1.9.4",
    "cloth-config": "*"
  }
